<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MotoTop.Desktop.ViewModels"
             xmlns:models="using:MotoTop.Desktop.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="MotoTop.Desktop.Views.MainView"
             x:DataType="vm:MainWindowViewModel">

    <Grid Background="#0F0F0F">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#171717"
                BorderBrush="#262626"
                BorderThickness="1"
                Padding="24">
            <StackPanel Spacing="24">
                <StackPanel Spacing="6">
                    <TextBlock Text="MOTO-TOP"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="Sistema de gestión de ventas, pedidos y cobranzas"
                               FontSize="12"
                               Foreground="#A2A2A2"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Secciones"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <ListBox ItemsSource="{Binding MenuItems}"
                             SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="0,12,0,0"
                             Foreground="White">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:MenuItemModel">
                                <Border Background="#1F1F1F"
                                        CornerRadius="14"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   Foreground="#A2A2A2"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom" Spacing="10">
                    <TextBlock Text="Acciones"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <Button Content="Cerrar sesión"
                            Command="{Binding LogoutCommand}"
                            Background="#D51920"
                            Foreground="White"
                            CornerRadius="10"
                            Height="40" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="#111111"
                BorderBrush="#262626"
                BorderThickness="1"
                Padding="24">
            <ContentControl Content="{Binding SelectedSectionViewModel}" />
        </Border>
    </Grid>
</UserControl>
