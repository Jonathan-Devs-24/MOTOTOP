<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MotoTop.Desktop.ViewModels"
        xmlns:v="using:MotoTop.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MotoTop.Desktop.Views.MainWindow"
        x:DataType="vm:AppViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MotoTop.Desktop">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <v:LoginView />
        </DataTemplate>
        <DataTemplate DataType="vm:MainWindowViewModel">
            <v:MainView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProductManagementViewModel">
            <v:ProductManagementView />
        </DataTemplate>
        <DataTemplate DataType="vm:SectionViewModel">
            <Border Background="#111111" Padding="24" CornerRadius="20" BorderBrush="#262626" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding Title}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="{Binding Description}"
                               FontSize="14"
                               Foreground="#A2A2A2"
                               TextWrapping="Wrap" />
                    <Border Background="#171717"
                            CornerRadius="16"
                            Padding="20"
                            BorderBrush="#2A2A2A"
                            BorderThickness="1">
                        <TextBlock Text="{Binding Placeholder}"
                                   FontSize="16"
                                   Foreground="White"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <ContentControl Content="{Binding CurrentViewModel}" />

</Window>
