<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MotoTop.Desktop.ViewModels"
        xmlns:v="using:MotoTop.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MotoTop.Desktop.Views.MainWindow"
        x:DataType="vm:AppViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MotoTop.Desktop">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:LoginViewModel">
            <v:LoginView />
        </DataTemplate>
        <DataTemplate DataType="vm:MainWindowViewModel">
            <TextBlock Text="{Binding Greeting}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </DataTemplate>
    </Window.DataTemplates>

    <ContentControl Content="{Binding CurrentViewModel}" />

</Window>
